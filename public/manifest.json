{
  "manifest_version": 3,
  "name": "M3ak (معاك) — Moroccan Darija AI Browser Assistant",
  "short_name": "M3ak",
  "version": "1.0.0",
  "description": "Your personal AI Browser Assistant that understands webpages and guides you step-by-step in natural Moroccan Darija.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "M3ak (معاك) — Moroccan Darija AI Browser Assistant"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assistant-avatar.png", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
